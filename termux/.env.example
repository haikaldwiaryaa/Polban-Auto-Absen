# ===== Kredensial akademik.polban.ac.id =====
# NIM mahasiswa (angka saja, contoh: 25......)
POLBAN_USERNAME=
# Password akademik — TULIS LANGSUNG apa adanya, TANPA kutip.
# Simbol # ! @ $ % & * SPASI aman. Hanya baris DIAWALI '#' yang jadi komentar.
#   BENAR : POLBAN_PASSWORD=p@ss#w0rd!2024#
POLBAN_PASSWORD=

# ===== Target & perilaku =====
# URL halaman absen (jarang perlu diubah)
POLBAN_TARGET_URL=https://akademik.polban.ac.id/ajar/absen
# Interval loop dalam detik (angka bulat, default 60)
POLBAN_INTERVAL=60
# Engine: http (ringan, default) atau pw (Playwright)
POLBAN_ENGINE=http
# Delay acak antar-klik dalam detik (desimal)
POLBAN_DELAY_MIN=1.2
POLBAN_DELAY_MAX=2.6
# Maksimal klik ulang per tombol sampai jadi hijau (angka bulat)
POLBAN_MAX_RETRY=5
# Jeda antar klik ulang dalam detik (desimal)
POLBAN_RETRY_WAIT=2.5
